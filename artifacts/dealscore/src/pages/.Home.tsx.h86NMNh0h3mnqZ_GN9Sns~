function iterativeSolve(
  startPrice: number,
  check: (price: number) => boolean,
  step = 1000,
  maxIter = 10000
): number | null {
  if (startPrice <= 0) return null;
  let price = Math.round(startPrice / step) * step;
  for (let i = 0; i < maxIter; i++) {
    if (price <= 0) return null;
    if (check(price)) return price;
    price -= step;
  }
  return null;
}

